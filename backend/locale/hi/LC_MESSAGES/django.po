# BYdoc API messages.
msgid ""
msgstr "Project-Id-Version: BYdoc\nReport-Msgid-Bugs-To: \nPOT-Creation-Date: 2026-09-09 00:00+0000\nPO-Revision-Date: 2026-09-09 00:00+0000\nLast-Translator: BYdoc team\nLanguage-Team: hi\nLanguage: hi\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "An authenticated user is required."
msgstr "लॉगिन किया हुआ उपयोगकर्ता आवश्यक है।"

msgid "An authenticated patient is required."
msgstr "मरीज़ को लॉगिन करना होगा।"

msgid "An authenticated booking user is required."
msgstr "बुकिंग करने वाले उपयोगकर्ता को लॉगिन करना होगा।"

msgid "An authenticated cancelling user is required."
msgstr "रद्द करने वाले उपयोगकर्ता को लॉगिन करना होगा।"

msgid "The doctor is not active at this clinic."
msgstr "इस क्लिनिक में डॉक्टर की प्रोफ़ाइल सक्रिय नहीं है।"

msgid "Online booking is not enabled for this doctor."
msgstr "इस डॉक्टर के लिए ऑनलाइन बुकिंग चालू नहीं है।"

msgid "The clinic is not currently active."
msgstr "क्लिनिक फ़िलहाल सक्रिय नहीं है।"

msgid "The organization is not currently active."
msgstr "संस्था फ़िलहाल सक्रिय नहीं है।"

msgid "Past appointment slots cannot be booked."
msgstr "बीते हुए समय के अपॉइंटमेंट स्लॉट बुक नहीं किए जा सकते।"

msgid "This appointment slot is unavailable."
msgstr "यह अपॉइंटमेंट स्लॉट उपलब्ध नहीं है।"

msgid "This slot is temporarily held by another user."
msgstr "यह स्लॉट किसी दूसरे उपयोगकर्ता के लिए अस्थायी रूप से आरक्षित है।"

msgid "The booking request identifier is invalid."
msgstr "बुकिंग अनुरोध का पहचानकर्ता अमान्य है।"

msgid "This booking request identifier has already been used."
msgstr "इस बुकिंग अनुरोध के पहचानकर्ता का पहले ही उपयोग हो चुका है।"

msgid "This slot does not have an active hold."
msgstr "इस स्लॉट के लिए कोई सक्रिय अस्थायी आरक्षण नहीं है।"

msgid "This slot is held by another user."
msgstr "यह स्लॉट किसी दूसरे उपयोगकर्ता के लिए आरक्षित है।"

msgid "The slot hold token is invalid."
msgstr "स्लॉट के अस्थायी आरक्षण का टोकन अमान्य है।"

msgid "The slot hold has expired."
msgstr "स्लॉट के अस्थायी आरक्षण की अवधि समाप्त हो गई है।"

msgid "Slots cannot be generated for an inactive affiliation."
msgstr "डॉक्टर और क्लिनिक का संबंध सक्रिय न होने पर अपॉइंटमेंट स्लॉट नहीं बनाए जा सकते।"

msgid "Online booking is not enabled for this affiliation."
msgstr "इस क्लिनिक में इस डॉक्टर के लिए ऑनलाइन बुकिंग चालू नहीं है।"

msgid "Slots cannot be generated for an inactive clinic."
msgstr "निष्क्रिय क्लिनिक के लिए अपॉइंटमेंट स्लॉट नहीं बनाए जा सकते।"

msgid "Slots cannot be generated for an inactive organization."
msgstr "निष्क्रिय संस्था के लिए अपॉइंटमेंट स्लॉट नहीं बनाए जा सकते।"

msgid "The clinic timezone is invalid."
msgstr "क्लिनिक का समय क्षेत्र अमान्य है।"

msgid "You cannot cancel this appointment."
msgstr "आप यह अपॉइंटमेंट रद्द नहीं कर सकते।"

msgid "Only confirmed appointments can be cancelled."
msgstr "केवल पुष्टि किए गए अपॉइंटमेंट रद्द किए जा सकते हैं।"

msgid "The cancellation note cannot exceed 250 characters."
msgstr "रद्द करने का नोट 250 अक्षरों से अधिक नहीं हो सकता।"

#, python-format
msgid "%(parameter)s must be a valid UUID."
msgstr "%(parameter)s एक मान्य UUID होना चाहिए।"

msgid "clinic_id is required."
msgstr "clinic_id देना आवश्यक है।"

msgid "date is required."
msgstr "date देना आवश्यक है।"

msgid "Appointment slot not found."
msgstr "अपॉइंटमेंट स्लॉट नहीं मिला।"

msgid "Appointment not found."
msgstr "अपॉइंटमेंट नहीं मिला।"

msgid "This language is not supported."
msgstr "यह भाषा समर्थित नहीं है।"
