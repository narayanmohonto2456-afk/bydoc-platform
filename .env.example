# Application
APP_ENV=development
APP_NAME=BYdoc
COMPOSE_PROJECT_NAME=bydoc-platform
APP_DEBUG=true
APP_ALLOWED_HOSTS=localhost,127.0.0.1

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-local-development-secret

# PostgreSQL
POSTGRES_DB=bydoc
POSTGRES_USER=bydoc
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# Frontend
NEXT_PUBLIC_APP_NAME=BYdoc
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Google Identity Services web client ID. Set the same value in frontend/.env.local.
GOOGLE_OAUTH_CLIENT_ID=

# One-time sign-in codes use verified email by default. SMS requires an AWS
# sender, entity registration, and approved templates before enabling.
OTP_SMS_ENABLED=false
AWS_SMS_REGION=
AWS_SMS_ORIGINATION_ID=
AWS_SMS_ENTITY_ID=
AWS_SMS_LOGIN_TEMPLATE_ID=
AWS_SMS_VERIFY_TEMPLATE_ID=

# Local account link delivery; configure a real provider before production.
ACCOUNT_LINK_BASE_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=BYdoc <noreply@localhost>
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=local-email

# Guided help and support requests work without a model. Set false to disable chat replies.
ASSISTANT_ENABLED=true
# Optional local topic classifier. Start native Ollama or the Compose profile and pull the model first.
AI_CHAT_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
