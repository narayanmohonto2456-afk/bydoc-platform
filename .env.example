# Application
APP_ENV=development
APP_NAME=SehatSaathi
APP_DEBUG=true
APP_ALLOWED_HOSTS=localhost,127.0.0.1

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-local-development-secret

# PostgreSQL
POSTGRES_DB=sehatsaathi
POSTGRES_USER=sehatsaathi
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# Frontend
NEXT_PUBLIC_APP_NAME=SehatSaathi
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Local account link delivery; configure a real provider before production.
ACCOUNT_LINK_BASE_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=SehatSaathi <noreply@localhost>
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=local-email
